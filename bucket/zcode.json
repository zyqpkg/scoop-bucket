{
    "version": "3.10.1",
    "description": "A full-featured Agentic Development Environment (ADE) built for Long Horizon Tasks, powered by Z.ai",
    "homepage": "https://zcode.z.ai/en",
    "license": {
        "identifier": "Proprietary",
        "url": "https://zcode.z.ai/en/terms"
    },
    "architecture": {
        "64bit": {
            "url": "https://cdn-zcode.z.ai/zcode/electron/releases/3.10.1/windows-x64/ZCode-3.10.1-win-x64.exe#/dl.7z",
            "hash": "68ae26af9d5da6c68a2f752d011296d70fb82deb9cc8c11541f2a2ea103ec8d8"
        }
    },
    "installer": {
        "script": [
            "Get-Item -Path \"$dir\\`$PLUGINSDIR\\app*.7z\" | Expand-7zipArchive -DestinationPath \"$dir\"",
            "Remove-Item -Path \"$dir\\`$*\", \"$dir\\Uninstall*\" -Recurse -Force"
        ]
    },
    "post_install": [
        "# Disable built-in update mechanism to prevent conflicts with Scoop's update management",
        "$yaml = \"$dir\\resources\\app-update.yml\"",
        "$content = Get-Content -Path $yaml | Foreach-Object {",
        "    if ($_.StartsWith('url')) { \"$($_.Replace('url', '# url')) # Disabled by Scoop\" } else { $_ }",
        "}",
        "Set-Content $yaml -Value $content -Encoding ascii"
    ],
    "shortcuts": [
        [
            "ZCode.exe",
            "ZCode"
        ]
    ],
    "checkver": {
        "script": [
            "$id = 'ZhipuAI.ZCode'",
            "$root = $id.Substring(0, 1).ToLower()",
            "$path = $id -replace '\\.', '/'",
            "$headers = @{ 'User-Agent' = 'scoop-checkver' }",
            "$token = Get-GitHubToken",
            "if ($token) { $headers['Authorization'] = \"token $token\" }",
            "$api = \"https://api.github.com/repos/microsoft/winget-pkgs/contents/manifests/$root/$path\"",
            "$content = $null",
            "for ($i = 0; $i -lt 3 -and !$content; $i++) {",
            "    try {",
            "        $versions = (Invoke-RestMethod -Uri $api -Headers $headers).name | Where-Object { $_ -match '^\\d+\\.\\d+\\.\\d+$' }",
            "        $latest = $versions | Sort-Object { [version]$_ } -Descending | Select-Object -First 1",
            "        $manifest = \"https://raw.githubusercontent.com/microsoft/winget-pkgs/master/manifests/$root/$path/$latest/$id.installer.yaml\"",
            "        $content = (Invoke-WebRequest -Uri $manifest -Headers $headers).Content",
            "    } catch {",
            "        Start-Sleep -Seconds (30 * ($i + 1))",
            "    }",
            "}",
            "if (!$content) { return '' }",
            "$url = ([regex]::Match($content, 'InstallerUrl:\\s*(\\S+)')).Groups[1].Value",
            "$hash = ([regex]::Match($content, 'InstallerSha256:\\s*(\\S+)')).Groups[1].Value.ToLower()",
            "\"$latest|$url|$hash\""
        ],
        "regex": "(?<version>\\d+(?:\\.\\d+)+)\\|(?<url>https?://[^\\|]+)\\|(?<hash>[a-f0-9]{64})"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "$matchUrl#/dl.7z",
                "hash": "$matchHash"
            }
        }
    }
}
