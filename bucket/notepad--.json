{
    "version": "3.9.0",
    "description": "Notepad-- 轻量级跨平台文本编辑器，支持 Win/Linux/Mac，国产可替代",
    "homepage": "https://github.com/cxasm/notepad--",
    "license": "GPL-3.0-or-later",
    "architecture": {
        "64bit": {
            "url": "https://github.com/cxasm/notepad--/releases/download/notepad-v3.9.0/Notepad--v3.9.0-win10-portable.zip",
            "hash": "5e19f287a9a01035f8e7171462f6298949e3625432b38db3b6f91a80b578f40a",
            "pre_install": [
                "$subdir = Get-ChildItem \"$dir\" -Directory -Filter 'Notepad--*-win10-portable' | Select-Object -First 1",
                "if ($subdir) { Move-Item \"$($subdir.FullName)\\*\" \"$dir\"; Remove-Item $subdir.FullName -Force -Recurse }"
            ]
        }
    },
    "bin": "Notepad--.exe",
    "shortcuts": [
        [
            "Notepad--.exe",
            "Notepad--"
        ]
    ],
    "checkver": {
        "github": "https://github.com/cxasm/notepad--",
        "regex": "notepad-v([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/cxasm/notepad--/releases/download/notepad-v$version/Notepad--v$version-win10-portable.zip"
            }
        }
    }
}
