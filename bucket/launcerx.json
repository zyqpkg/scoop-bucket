{
  "version": "2.1.2",
  "description": "LauncherX - Modern app launcher for Windows",
  "homepage": "https://github.com/Apollo199999999/LauncherX",
  "license": "MIT",
  "architecture": {
    "64bit": {
      "url": "https://github.com/Apollo199999999/LauncherX/releases/download/v2.1.2/LauncherX_2.1.2_x64_Setup.exe",
      "hash": ""
    }
  },
  "installer": {
    "script": [
      "$file = (Get-ChildItem \"$dir\" 'LauncherX*.exe' | Select-Object -First 1).FullName",
      "Expand-7ZipArchive \"$file\" \"$dir\\\" -Removal",
      "Expand-7ZipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\" -Removal",
      "Remove-Item \"$dir\\`$PLUGINSDIR\",\"$dir\\`$R0\"  -Force -Recurse"
    ]
  },
  "shortcuts": [
    [
      "LauncherX.exe",
      "LauncherX"
    ]
  ],
  "checkver": "github",
  "autoupdate": {
    "architecture": {
      "64bit": {
        "url": "https://github.com/Apollo199999999/LauncherX/releases/download/v$version/LauncherX-$version-windows-x64.exe"
      }
    }
  }
}
