{
    "version": "6.0.0",
    "description": "Clipboard manager with history, search and snippets. Reads existing Clipdiary databases.",
    "homepage": "https://github.com/zouyq/openclip",
    "license": "Freeware",
    "architecture": {
        "64bit": {
            "url": "https://github.com/zouyq/openclip/releases/download/v6.0.0/openclip-6.0.0.zip",
            "hash": "111272415b45cc38207161c27ee54f97772f62046520935cb7c95a86a34e1a76"
        }
    },
    "bin": [
        [
            "openclip.exe",
            "openclip",
            "--portable"
        ]
    ],
    "shortcuts": [
        [
            "openclip.exe",
            "OpenClip",
            "--portable"
        ]
    ],
    "persist": "data",
    "post_uninstall": [
        "Remove-ItemProperty -Path 'HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Run' -Name OpenClip -ErrorAction SilentlyContinue"
    ],
    "checkver": {
        "github": "https://github.com/zouyq/openclip",
        "regex": "v([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/zouyq/openclip/releases/download/v$version/openclip-$version.zip"
            }
        }
    },
    "notes": [
        "Data (config, diary.db, backups, snippet libraries) lives in scoop\\persist\\openclip\\data",
        "and survives upgrades and uninstalls. Drop an existing diary.db in there to import history."
    ]
}
