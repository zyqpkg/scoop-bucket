{
    "version": "0.1.5",
    "description": "The open-source control plane for coding agents. Orchestrate Claude Code, Codex, OpenCode, Cursor, and Grok from one surface.",
    "homepage": "https://t3.codes",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/pingdotgg/t3code/releases/download/v0.1.5/T3-Code-0.1.5-x64.exe#/dl.7z",
            "hash": "sha512:ffd31a014c12ab6b9e727c6f335d33819d38286a7dbe200bd9fded53c9bf97dcaedd06de794277cc606b512f6accd211035eecc2cf70a2b3b8882cbe8d75f77f"
        }
    },
    "installer": {
        "script": [
            "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\"",
            "Remove-Item \"$dir\\`$PLUGINSDIR\", \"$dir\\Uninstall*\", \"$dir\\`$R0\" -Force -Recurse -ErrorAction SilentlyContinue",
            "$exe = Get-ChildItem \"$dir\\T3 Code*.exe\" -ErrorAction SilentlyContinue | Select-Object -First 1",
            "if ($exe) { Rename-Item $exe.FullName 'T3 Code.exe' -Force }"
        ]
    },
    "bin": [
        [
            "T3 Code.exe",
            "t3code"
        ]
    ],
    "shortcuts": [
        [
            "T3 Code.exe",
            "T3 Code"
        ]
    ],
    "checkver": {
        "github": "https://github.com/pingdotgg/t3code"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/pingdotgg/t3code/releases/download/v$version/T3-Code-$version-x64.exe#/dl.7z"
            }
        },
        "hash": {
            "url": "$baseurl/latest.yml",
            "regex": "(?sm)$basename.*?sha512:\\s+$base64"
        }
    }
}
