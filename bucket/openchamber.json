    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/openchamber/openchamber/releases/download/v2.3.1/OpenChamber-2.3.1-win-x64.exe#/dl.7z",
            "hash": "c2b630cf4979d4fd6319927d4d46ca1688b1710d1eddc6a0dc005a17ec0c564f"
        }
    },
    "installer": {
        "script": [
            "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\"",
            "Remove-Item \"$dir\\`$PLUGINSDIR\", \"$dir\\Uninstall*\" -Force -Recurse"
        ]
    },
    "shortcuts": [
        [
            "OpenChamber.exe",
            "OpenChamber"
        ]
    ],
    "checkver": {
        "github": "https://github.com/openchamber/openchamber"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/openchamber/openchamber/releases/download/v$version/OpenChamber-$version-win-x64.exe#/dl.7z"
            }
        },
        "hash": {
            "url": "$baseurl/latest.yml",
            "regex": "(?sm)$basename.*?sha512:\\s+$base64"
        }
    }
}
