{
    "version": "0.13.2",
    "description": "水杉输入法 - 开源的 Windows TSF 输入法 (Metasequoia IME)。安装包为全局安装，程序文件写入 C:\\Program Files\\metasequoiaime，需要管理员权限",
    "homepage": "https://github.com/metasequoiaime/MSIME-Windows",
    "license": "GPL-3.0-only",
    "url": "https://github.com/metasequoiaime/MSIME-Windows/releases/download/v0.13.2/MetasequoiaIME_Setup_v0.13.2.exe",
    "hash": "34db47d0d6894164f83c665cccb809de9e8e3ff36f975fed63d3069f02108a7d",
    "installer": {
        "script": [
            "if (-not (is_admin)) { error 'Administrator privileges are required to install the IME (TSF DLL must be registered in System32/SysWOW64).'; break }",
            "$dataDir = Join-Path $env:LOCALAPPDATA 'metasequoiaime'",
            "$keepDir = \"${dataDir}.scoop-keep\"",
            "if (Test-Path $keepDir) { Remove-Item $dataDir -Recurse -Force -ErrorAction SilentlyContinue; Rename-Item -Path $keepDir -NewName 'metasequoiaime' }",
            "Start-Process -FilePath \"$dir\\MetasequoiaIME_Setup_v$version.exe\" -ArgumentList '/VERYSILENT' -Wait -NoNewWindow"
        ]
    },
    "uninstaller": {
        "script": [
            "$dataDir = Join-Path $env:LOCALAPPDATA 'metasequoiaime'",
            "$keepDir = \"${dataDir}.scoop-keep\"",
            "Stop-Process -Name 'MetasequoiaImeServer','MetasequoiaImeWatchdog','MetasequoiaImeSettings' -Force -ErrorAction SilentlyContinue",
            "if (Test-Path $keepDir) { throw 'Stale metasequoiaime.scoop-keep from an interrupted update; resolve it manually before continuing.' }",
            "if ((Test-Path $dataDir) -and -not (Test-Path $keepDir)) { Rename-Item -Path $dataDir -NewName 'metasequoiaime.scoop-keep' }",
            "if ((Test-Path $dataDir) -and -not (Test-Path $keepDir)) { throw 'Cannot preserve MSIME user data; aborting uninstall.' }",
            "Invoke-ExternalCommand \"$dir\\unins000.exe\" -ArgumentList '/VERYSILENT' -RunAs | Out-Null"
        ]
    },
    "checkver": {
        "github": "https://github.com/metasequoiaime/MSIME-Windows"
    },
    "autoupdate": {
        "url": "https://github.com/metasequoiaime/MSIME-Windows/releases/download/v$version/MetasequoiaIME_Setup_v$version.exe"
    }
}
