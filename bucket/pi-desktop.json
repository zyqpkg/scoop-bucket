    "homepage": "https://github.com/vastsa/PI-Desktop",
    "license": "LGPL-3.0",
    "architecture": {
        "64bit": {
            "url": "https://github.com/vastsa/PI-Desktop/releases/download/v0.16.1/PI-Desktop-Setup-0.16.1.exe#/dl.7z",
            "hash": "sha512:e07669753cdd1e60c335d6114cfe9149fe00ab82d58b98686ba392ee33db89d954f1d09a146ca329adce621205479e70cf72b26a681045463fd0e60e9276b216"
        }
    },
    "installer": {
        "script": [
            "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\"",
            "Remove-Item \"$dir\\`$PLUGINSDIR\", \"$dir\\Uninstall*\", \"$dir\\`$R0\" -Force -Recurse -ErrorAction SilentlyContinue"
        ]
    },
    "bin": [
        [
            "PI-Desktop.exe",
            "pi-desktop"
        ]
    ],
    "shortcuts": [
        [
            "PI-Desktop.exe",
            "PI-Desktop"
        ]
    ],
    "checkver": {
        "github": "https://github.com/vastsa/PI-Desktop"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/vastsa/PI-Desktop/releases/download/v$version/PI-Desktop-Setup-$version.exe#/dl.7z"
            }
        },
        "hash": {
            "url": "$baseurl/latest.yml",
            "regex": "(?sm)$basename.*?sha512:\\s+$base64"
        }
    }
}
