{
    "version": "0.15.8",
    "description": "Local-first AI coding agent desktop: Electron + Rust host core + pi Agent Harness + user-installable plugins",
    "homepage": "https://github.com/vastsa/PI-Desktop",
    "license": "LGPL-3.0",
    "architecture": {
        "64bit": {
            "url": "https://github.com/vastsa/PI-Desktop/releases/download/v0.15.8/PI-Desktop-Setup-0.15.8.exe#/dl.7z",
            "hash": "sha512:5b2a82ef920ed0db0bf1b53eec00c901ba38d8b2c56f24a1fac66104724c91cc6d711df6915fe8beca28310741cc30ff6ed79dd80a8eaa6e4db434bdf2aa207c"
        }
    },
    "installer": {
        "script": [
            "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\"",
            "Remove-Item \"$dir\\`$PLUGINSDIR\", \"$dir\\Uninstall*\", \"$dir\\`$R0\" -Force -Recurse -ErrorAction SilentlyContinue"
        ]
    },
    "bin": [
        [
            "PI-Desktop.exe",
            "pi-desktop"
        ]
    ],
    "shortcuts": [
        [
            "PI-Desktop.exe",
            "PI-Desktop"
        ]
    ],
    "checkver": {
        "github": "https://github.com/vastsa/PI-Desktop"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/vastsa/PI-Desktop/releases/download/v$version/PI-Desktop-Setup-$version.exe#/dl.7z"
            }
        },
        "hash": {
            "url": "$baseurl/latest.yml",
            "regex": "(?sm)$basename.*?sha512:\\s+$base64"
        }
    }
}
