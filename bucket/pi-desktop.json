            "hash": "sha512:e9fc55ccbbb49f040b04a5d0a19a84a79d845202f4f885576544d2308c76f695adb986eca0b3bb7f805f059702b8a3064ddca198b3d23921a01f6e8f3496ac0d"
        }
    },
    "installer": {
        "script": [
            "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\"",
