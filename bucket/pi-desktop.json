    "homepage": "https://github.com/vastsa/PI-Desktop",
    "license": "LGPL-3.0",
    "architecture": {
        "64bit": {
            "url": "https://github.com/vastsa/PI-Desktop/releases/download/v0.14.6/PI-Desktop-Setup-0.14.6.exe#/dl.7z",
            "hash": "sha512:59ab3399180211f307e5227da7a0d98d41fa68cd9d1130870271ee1fa4baeeffd504204a6d266eba9423b03e55138592f647a3b954e8e5128a61865a4ca646cf"
        }
    },
    "installer": {
        "script": [
            "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\"",
            "Remove-Item \"$dir\\`$PLUGINSDIR\", \"$dir\\Uninstall*\", \"$dir\\`$R0\" -Force -Recurse -ErrorAction SilentlyContinue"
        ]
    },
    "bin": [
        [
            "PI-Desktop.exe",
            "pi-desktop"
        ]
    ],
    "shortcuts": [
        [
            "PI-Desktop.exe",
            "PI-Desktop"
        ]
    ],
    "checkver": {
        "github": "https://github.com/vastsa/PI-Desktop"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/vastsa/PI-Desktop/releases/download/v$version/PI-Desktop-Setup-$version.exe#/dl.7z"
            }
        },
        "hash": {
            "url": "$baseurl/latest.yml",
            "regex": "(?sm)$basename.*?sha512:\\s+$base64"
        }
    }
}
