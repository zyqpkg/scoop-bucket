    "homepage": "https://github.com/vastsa/PI-Desktop",
    "license": "LGPL-3.0",
    "architecture": {
        "64bit": {
            "url": "https://github.com/vastsa/PI-Desktop/releases/download/v0.15.6/PI-Desktop-Setup-0.15.6.exe#/dl.7z",
            "hash": "sha512:146af6d5b21ecfbe28bac3f9e9efaac9da6a5fd0bb4a475259ab4ae87217e7e2691b01ad7eac20099c47928b7541cfff5a1e27b3424d76901727ba7ae348f778"
        }
    },
    "installer": {
        "script": [
            "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\"",
            "Remove-Item \"$dir\\`$PLUGINSDIR\", \"$dir\\Uninstall*\", \"$dir\\`$R0\" -Force -Recurse -ErrorAction SilentlyContinue"
        ]
    },
    "bin": [
        [
            "PI-Desktop.exe",
            "pi-desktop"
        ]
    ],
    "shortcuts": [
        [
            "PI-Desktop.exe",
            "PI-Desktop"
        ]
    ],
    "checkver": {
        "github": "https://github.com/vastsa/PI-Desktop"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/vastsa/PI-Desktop/releases/download/v$version/PI-Desktop-Setup-$version.exe#/dl.7z"
            }
        },
        "hash": {
            "url": "$baseurl/latest.yml",
            "regex": "(?sm)$basename.*?sha512:\\s+$base64"
        }
    }
}
