{
    "version": "0.5.7",
    "description": "Desktop app for the pi coding agent runtime with timeline, terminal, and diff viewer",
    "homepage": "https://github.com/justhil/pi-app",
    "license": "MIT",
    "url": "https://github.com/justhil/pi-app/releases/download/v0.5.7/pi.Desktop-Portable-0.5.7-x64.exe",
    "hash": "b81b6a4912cca67afa78a2b813992c4428ee85a39c6c67bc5043e9d4f8aaa4ca",
    "installer": {
        "script": [
            "Expand-7ZipArchive \"$dir\\$fname\" \"$dir\\temp\" -Removal",
            "Get-ChildItem \"$dir\\temp\\`$PLUGINSDIR\" -Filter '*.7z' | ForEach-Object {",
            "    Expand-7ZipArchive $_.FullName \"$dir\"",
            "}",
            "Remove-Item -Recurse -Force \"$dir\\temp\""
        ]
    },
    "bin": "pi Desktop.exe",
    "shortcuts": [
        [
            "pi Desktop.exe",
            "Pi Desktop"
        ]
    ],
    "checkver": {
        "github": "https://github.com/justhil/pi-app"
    },
    "autoupdate": {
        "url": "https://github.com/justhil/pi-app/releases/download/v$version/pi.Desktop-Portable-$version-x64.exe"
    }
}
