    "homepage": "https://github.com/vastsa/PI-Desktop",
    "license": "LGPL-3.0",
    "architecture": {
        "64bit": {
            "url": "https://github.com/vastsa/PI-Desktop/releases/download/v0.14.5/PI-Desktop-Setup-0.14.5.exe#/dl.7z",
            "hash": "sha512:20936b6f00f828ed60a99e0ec24a157e8a5e671caca4cb2d345eddd98133a4b959472f0b3dc22f75a4f77e285924e810ceb2a179a2a85a537175e8ea68d8ac4b"
        }
    },
    "installer": {
        "script": [
            "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\"",
            "Remove-Item \"$dir\\`$PLUGINSDIR\", \"$dir\\Uninstall*\", \"$dir\\`$R0\" -Force -Recurse -ErrorAction SilentlyContinue"
        ]
    },
    "bin": [
        [
            "PI-Desktop.exe",
            "pi-desktop"
        ]
    ],
    "shortcuts": [
        [
            "PI-Desktop.exe",
            "PI-Desktop"
        ]
    ],
    "checkver": {
        "github": "https://github.com/vastsa/PI-Desktop"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/vastsa/PI-Desktop/releases/download/v$version/PI-Desktop-Setup-$version.exe#/dl.7z"
            }
        },
        "hash": {
            "url": "$baseurl/latest.yml",
            "regex": "(?sm)$basename.*?sha512:\\s+$base64"
        }
    }
}
