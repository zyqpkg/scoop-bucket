{
    "homepage": "https://clipdiary.com/",
    "version": "5.73",
    "license": "Proprietary",
    "description": "A clipboard manager with history and snippets for frequently used text",
    "architecture": {
        "64bit": {
            "url": "https://clipdiary.com/download/clipdiary_portable_5.73.zip",
            "hash": "d55475841f629e26fc48bef2e13660cee6d6d72ed753828bc01f7c2974df09b5"
        }
    },
    "extract_dir": "clipdiary_portable",
    "pre_install": [
        "ensure $persist_dir | Out-Null",
        "if (!(Test-Path \"$persist_dir\\diary.db\")) {",
        "    $oldDb = Get-ChildItem (Split-Path $dir) -Filter 'diary.db' -Recurse | Select-Object -First 1",
        "    if ($oldDb) { Copy-Item $oldDb.FullName \"$persist_dir\\diary.db\" -Force } else { New-Item \"$persist_dir\\diary.db\" -ItemType File -Force | Out-Null }",
        "}",
        "if (!(Test-Path \"$persist_dir\\clipdiary.cfg\")) {",
        "    $oldCfg = Get-ChildItem (Split-Path $dir) -Filter 'clipdiary.cfg' -Recurse | Select-Object -First 1",
        "    if ($oldCfg) { Copy-Item $oldCfg.FullName \"$persist_dir\\clipdiary.cfg\" -Force } else { New-Item \"$persist_dir\\clipdiary.cfg\" -ItemType File -Force | Out-Null }",
        "}"
    ],
    "bin": "clipdiary-portable.exe",
    "shortcuts": [
        [
            "clipdiary-portable.exe",
            "Clipdiary"
        ]
    ],
    "persist": [
        "clipdiary.cfg",
        "diary.db",
        "Backup",
        "ClipVault"
    ],
    "checkver": {
        "url": "https://clipdiary.com/download",
        "regex": "clipdiary_portable_([\\d.]+)\\.zip",
        "reverse": "true"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://clipdiary.com/download/clipdiary_portable_$version.zip"
            }
        }
    },
    "notes": [
        "Clipdiary is a clipboard manager that automatically saves clipboard history.",
        "Free to use with conditions:",
        "  - Private computer use",
        "  - Non-profit organization use",
        "  - Income under $1500/month (if work-related)",
        "  - 60-day trial for all other uses",
        "License can be activated via Help -> Activate Free in the main menu.",
        "Visit https://clipdiary.com/ for more information and to purchase a license."
    ]
}
