{
    "version": "2.0.4",
    "description": "A modern remote terminal workspace - SSH/SFTP/Telnet/Serial client with tabbed workspace, AI assistant, GPU/Docker/process monitoring (Rust + GPUI native)",
    "homepage": "https://nyaterm.app",
    "license": "MIT",
    "notes": [
        "NyaTerm 2.0.0 is the official Rust + GPUI native rewrite, replacing the legacy Tauri/WebView architecture.",
        "IMPORTANT: Back up your data directory and export a .nya snapshot before upgrading from 1.x.",
        "Migration guide: https://nyaterm.app/docs/getting-started/migration-v2"
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/nyakang/nyaterm/releases/download/v2.0.4/NyaTerm_2.0.4_windows_x64_portable.zip",
            "hash": "6a73ac2cf4a35eb01820835e1e74a9d22be855c5978e9e70bb3f3228619f1a09"
        },
        "arm64": {
            "url": "https://github.com/nyakang/nyaterm/releases/download/v2.0.4/NyaTerm_2.0.4_windows_arm64_portable.zip",
            "hash": "22403ff4a9df46a646b0d319a228f27b32cbfc6e78fcf2c4ac95ba8cfe6e290e"
        }
    },
    "pre_install": [
        "$src = Join-Path $dir 'NyaTerm-portable'",
        "if (Test-Path -LiteralPath $src) {",
        "    Get-ChildItem -LiteralPath $src -Force | ForEach-Object {",
        "        # Zip contains an empty stub named nyaterm-portable; moving it onto $dir collides with the source folder on Windows (case-insensitive).",
        "        if ($_.Name -ieq 'nyaterm-portable') {",
        "            Remove-Item -LiteralPath $_.FullName -Force -ErrorAction SilentlyContinue",
        "        } else {",
        "            Move-Item -LiteralPath $_.FullName -Destination $dir -Force",
        "        }",
        "    }",
        "    Remove-Item -LiteralPath $src -Force -Recurse -ErrorAction SilentlyContinue",
        "    New-Item -Path (Join-Path $dir 'nyaterm-portable') -ItemType File -Force | Out-Null",
        "}"
    ],
    "bin": "NyaTerm.exe",
    "shortcuts": [
        [
            "NyaTerm.exe",
            "NyaTerm"
        ]
    ],
    "persist": "data",
    "checkver": {
        "github": "https://github.com/nyakang/nyaterm"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/nyakang/nyaterm/releases/download/v$version/NyaTerm_$version_windows_x64_portable.zip",
                "hash": {
                    "url": "https://github.com/nyakang/nyaterm/releases/download/v$version/SHA256SUMS",
                    "regex": "(?i)([a-fA-F0-9]{64})\\s+NyaTerm_$version_windows_x64_portable\\.zip"
                }
            },
            "arm64": {
                "url": "https://github.com/nyakang/nyaterm/releases/download/v$version/NyaTerm_$version_windows_arm64_portable.zip",
                "hash": {
                    "url": "https://github.com/nyakang/nyaterm/releases/download/v$version/SHA256SUMS",
                    "regex": "(?i)([a-fA-F0-9]{64})\\s+NyaTerm_$version_windows_arm64_portable\\.zip"
                }
            }
        }
    }
}
