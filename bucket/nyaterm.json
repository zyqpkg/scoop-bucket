{
    "version": "2.0.0",
    "description": "A modern remote terminal workspace - SSH/SFTP/Telnet/Serial client with tabbed workspace, AI assistant, GPU/Docker/process monitoring",
    "homepage": "https://nyaterm.app",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/nyakang/nyaterm/releases/download/v2.0.0/NyaTerm_2.0.0_windows_x64_portable.zip",
            "hash": "68b7d9fe746e65ce1e05b3ba69acff8bdb4cb303c3e238f532061995e0631b18"
        },
        "arm64": {
            "url": "https://github.com/nyakang/nyaterm/releases/download/v2.0.0/NyaTerm_2.0.0_windows_arm64_portable.zip",
            "hash": "1b19549e5623745dbf6eb80eaffc0f983ca9c18842e16ccc9ec914526dcce305"
        }
    },
    "pre_install": [
        "$src = Join-Path $dir 'NyaTerm-portable'",
        "if (Test-Path -LiteralPath $src) {",
        "    Get-ChildItem -LiteralPath $src -Force | ForEach-Object {",
        "        # Zip may contain an empty stub named nyaterm-portable; skip it to avoid case-insensitive collision.",
        "        if ($_.Name -ieq 'nyaterm-portable') {",
        "            Remove-Item -LiteralPath $_.FullName -Force -ErrorAction SilentlyContinue",
        "        } else {",
        "            Move-Item -LiteralPath $_.FullName -Destination $dir -Force",
        "        }",
        "    }",
        "    Remove-Item -LiteralPath $src -Force -Recurse -ErrorAction SilentlyContinue",
        "}"
    ],
    "bin": "NyaTerm.exe",
    "shortcuts": [
        [
            "NyaTerm.exe",
            "NyaTerm"
        ]
    ],
    "persist": "data",
    "checkver": {
        "github": "https://github.com/nyakang/nyaterm"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/nyakang/nyaterm/releases/download/v$version/NyaTerm_$version_windows_x64_portable.zip"
            },
            "arm64": {
                "url": "https://github.com/nyakang/nyaterm/releases/download/v$version/NyaTerm_$version_windows_arm64_portable.zip"
            }
        }
    }
}
