{
    "version": "0.11.1",
    "description": "Coding agents from your phone, desktop and CLI (Desktop Edition)",
    "homepage": "https://paseo.sh",
    "license": "AGPL-3.0-only",
    "notes": [
        "Paseo uses a local daemon to manage coding agents.",
        "Desktop: opening the Paseo app starts the daemon automatically.",
        "CLI / headless:",
        "  paseo daemon start     # start the daemon",
        "  paseo daemon status    # check status",
        "  paseo daemon stop      # stop the daemon",
        "CLI reference: https://paseo.sh/docs/cli"
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/getpaseo/paseo/releases/download/v0.11.1/Paseo-Setup-0.11.1-x64.exe#/dl.7z",
            "hash": "sha512:6807158096692c8b4a75fcfc12951a9db9bc1f4013fae1264e4446b5991f3c97ea968ff33e7c1389924a3a745d87543443ff36e80bfcd6a7be0e5fa06f15a645"
        },
        "arm64": {
            "url": "https://github.com/getpaseo/paseo/releases/download/v0.11.1/Paseo-Setup-0.11.1-arm64.exe#/dl.7z",
            "hash": "sha512:7ad12313892d4c1b43d2fbb63eb38cd5f80d2faa5f4b745991708b21a03df3a055a5f2868d264d25f3c880fef6b3e5b19c69d6ca6916a16574bd076bbf9b352f"
        }
    },
    "installer": {
        "script": [
            "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-*.7z\" \"$dir\"",
            "Remove-Item \"$dir\\`$PLUGINSDIR\", \"$dir\\Uninstall*\", \"$dir\\`$R0\" -Force -Recurse -ErrorAction SilentlyContinue"
        ]
    },
    "bin": "resources\\bin\\paseo.cmd",
    "shortcuts": [
        [
            "Paseo.exe",
            "Paseo"
        ]
    ],
    "checkver": {
        "github": "https://github.com/getpaseo/paseo"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/getpaseo/paseo/releases/download/v$version/Paseo-Setup-$version-x64.exe#/dl.7z"
            },
            "arm64": {
                "url": "https://github.com/getpaseo/paseo/releases/download/v$version/Paseo-Setup-$version-arm64.exe#/dl.7z"
            }
        },
        "hash": {
            "url": "$baseurl/latest.yml",
            "regex": "(?sm)$basename.*?sha512:\\s+$base64"
        }
    }
}
