{
    "version": "latest",
    "description": "Focused desktop experience for working on Codex threads in parallel.",
    "homepage": "https://developers.openai.com/codex/app",
    "license": "Proprietary",
    "url": "https://get.microsoft.com/installer/download/9PLM9XGG6VKS?cid=website_cta_psi#/codex-installer.exe",
    "hash": "skip",
    "installer": {
        "script": [
            "$installer = Get-ChildItem \"$dir\" 'codex-installer.exe' | Select-Object -First 1",
            "if (!$installer) { error 'Codex installer was not downloaded.' }",
            "Start-Process -FilePath $installer.FullName -Wait"
        ]
    },
    "post_install": "Remove-Item \"$dir\\codex-installer.exe\" -Force -ErrorAction SilentlyContinue"
}
