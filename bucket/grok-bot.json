        "url": "https://cursor.com/download/bot",
        "regex": "grokbot/stable/win32-x64/([\\d.]+)/"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://downloads.cursor.com/grokbot/stable/win32-x64/$version/Grok_Bot_$version_Setup.exe"
